menu "Nav display options"

config EXAMPLE_DOUBLE_FB
    bool "Double frame buffer (2 x 450 KiB PSRAM)"
    default n

config EXAMPLE_USE_BOUNCE_BUFFER
    bool "Bounce buffer (10 x 480 px)"
    depends on !EXAMPLE_DOUBLE_FB
    default y

config EXAMPLE_AVOID_TEAR_EFFECT_WITH_SEM
    bool "Tear-effect avoid with vsync semaphores"
    depends on !EXAMPLE_DOUBLE_FB
    default n

endmenu
